<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<!-- Card de una camiseta en "Mi lista de deseos" (igual al card del catálogo, con el corazón lleno) -->
<VBox fx:id="paneCardFavorito" maxWidth="-Infinity" minWidth="-Infinity" prefWidth="236.0" styleClass="favorite-card" stylesheets="@../../Styles/StyleSheetsComponents/favorite_item_component.css" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.ComponentsControllers.Favorite_Item_ComponentController">
   <padding>
      <Insets bottom="12.0" left="10.0" right="10.0" top="10.0" />
   </padding>
   <children>
      <StackPane fx:id="paneImagen" minHeight="170.0" prefHeight="170.0" styleClass="favorite-image-area">
         <children>
            <SVGPath fx:id="svgCamisetaGenerica" content="M34,0 Q53,13 72,0 L106,18 L95,41 L80,34 L80,108 L26,108 L26,34 L11,41 L0,18 Z" styleClass="favorite-image-placeholder" />
            <ImageView fx:id="imgProducto" fitHeight="150.0" fitWidth="150.0" pickOnBounds="true" preserveRatio="true" />
            <Label fx:id="lblEtiqueta" managed="false" styleClass="favorite-badge" text="Agotado" visible="false" StackPane.alignment="TOP_LEFT">
               <StackPane.margin>
                  <Insets left="8.0" top="8.0" />
               </StackPane.margin>
            </Label>
            <Button fx:id="btnQuitarFavorito" mnemonicParsing="false" onAction="#onQuitarFavorito" styleClass="favorite-heart-button" text="♥" StackPane.alignment="TOP_RIGHT">
               <StackPane.margin>
                  <Insets right="8.0" top="8.0" />
               </StackPane.margin>
            </Button>
         </children>
      </StackPane>

      <VBox fx:id="vbInfo" spacing="2.0">
         <padding>
            <Insets left="4.0" right="4.0" top="12.0" />
         </padding>
         <children>
            <Label fx:id="lblNombreEquipo" styleClass="favorite-team" text="Barcelona" />
            <Label fx:id="lblVersion" styleClass="favorite-season" text="Local 2026/27" />
            <HBox alignment="CENTER_LEFT" spacing="6.0">
               <VBox.margin>
                  <Insets top="2.0" />
               </VBox.margin>
               <children>
                  <Circle fx:id="cirLiga" radius="3.5" styleClass="league-dot" />
                  <Label fx:id="lblLiga" styleClass="favorite-league" text="La Liga" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT">
               <VBox.margin>
                  <Insets top="12.0" />
               </VBox.margin>
               <children>
                  <Label fx:id="lblPrecio" styleClass="favorite-price" text="\$ 189.900" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnAgregarCarrito" mnemonicParsing="false" onAction="#onAgregarCarrito" styleClass="favorite-add-button" text="+" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</VBox>
