<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- Línea del carrito de compras del cliente -->
<HBox fx:id="paneItemCarrito" alignment="CENTER_LEFT" spacing="18.0" styleClass="cart-item" stylesheets="@../../Styles/StyleSheetsComponents/cart_item_component.css" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.ComponentsControllers.Cart_Item_ComponentController">
   <padding>
      <Insets bottom="12.0" left="12.0" right="14.0" top="12.0" />
   </padding>
   <children>
      <!-- Imagen -->
      <StackPane fx:id="paneImagen" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="64.0" minWidth="64.0" prefHeight="64.0" prefWidth="64.0" styleClass="cart-item-image">
         <children>
            <SVGPath fx:id="svgCamisetaGenerica" content="M34,0 Q53,13 72,0 L106,18 L95,41 L80,34 L80,108 L26,108 L26,34 L11,41 L0,18 Z" scaleX="0.45" scaleY="0.45" styleClass="cart-item-placeholder" />
            <ImageView fx:id="imgProducto" fitHeight="56.0" fitWidth="56.0" pickOnBounds="true" preserveRatio="true" />
         </children>
      </StackPane>

      <!-- Datos, cantidad y mover a favoritos -->
      <VBox fx:id="vbInfo" minWidth="0.0" spacing="2.0" HBox.hgrow="ALWAYS">
         <children>
            <Label fx:id="lblNombre" styleClass="cart-item-name" text="Camiseta Barcelona" />
            <Label fx:id="lblVersionLiga" styleClass="cart-item-muted" text="Local 2026/27 · La Liga" />
            <Label fx:id="lblTalla" styleClass="cart-item-muted" text="Talla: L" />
            <HBox fx:id="hbAcciones" alignment="CENTER_LEFT" spacing="12.0">
               <VBox.margin>
                  <Insets top="6.0" />
               </VBox.margin>
               <children>
                  <HBox alignment="CENTER" styleClass="cart-stepper">
                     <children>
                        <Button fx:id="btnRestar" mnemonicParsing="false" onAction="#onRestar" styleClass="cart-stepper-button" text="−" />
                        <Label fx:id="lblCantidad" alignment="CENTER" minWidth="26.0" styleClass="cart-stepper-value" text="1" />
                        <Button fx:id="btnSumar" mnemonicParsing="false" onAction="#onSumar" styleClass="cart-stepper-button" text="+" />
                     </children>
                  </HBox>
                  <Hyperlink fx:id="lnkMoverFavoritos" onAction="#onMoverAFavoritos" styleClass="cart-item-favorite" text="♡  Mover a favoritos" />
               </children>
            </HBox>
         </children>
      </VBox>

      <!-- Precio y eliminar -->
      <VBox fx:id="vbPrecio" alignment="TOP_RIGHT" minWidth="110.0">
         <children>
            <Label fx:id="lblSubtotal" styleClass="cart-item-subtotal" text="\$ 189.900" />
            <Label fx:id="lblPrecioUnitario" styleClass="cart-item-muted" text="\$ 189.900 c/u" />
            <Region VBox.vgrow="ALWAYS" />
            <Hyperlink fx:id="lnkEliminar" onAction="#onEliminar" styleClass="cart-item-remove" text="Eliminar" />
         </children>
      </VBox>
   </children>
</HBox>
