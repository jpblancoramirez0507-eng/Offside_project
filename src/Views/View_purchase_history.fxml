<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- "Mis compras": historial del cliente, en el centro del catálogo (Controller_view_catalog) -->
<ScrollPane fx:id="spMisCompras" fitToWidth="true" hbarPolicy="NEVER" styleClass="admin-scroll" stylesheets="@../Styles/Style_sheet.css" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.Controller_view_purchase_history">
   <content>
      <VBox fx:id="vbMisCompras" spacing="14.0" styleClass="catalog-content">
         <padding>
            <Insets bottom="24.0" left="24.0" right="24.0" top="18.0" />
         </padding>
         <children>
            <VBox>
               <children>
                  <Label fx:id="lblTitulo" styleClass="admin-title" text="Mis compras" />
                  <Label fx:id="lblCantidadPedidos" styleClass="admin-subtitle" text="0 pedidos realizados" />
               </children>
            </VBox>

            <HBox fx:id="hbCuerpo" spacing="18.0">
               <children>
                  <VBox spacing="12.0" HBox.hgrow="ALWAYS">
                     <children>
                        <!-- Filtro por estado -->
                        <HBox fx:id="hbFiltros" spacing="8.0">
                           <children>
                              <ToggleButton fx:id="tbTodos" mnemonicParsing="false" selected="true" styleClass="status-filter" text="Todos" userData="TODOS">
                                 <toggleGroup>
                                    <ToggleGroup fx:id="tgEstado" />
                                 </toggleGroup>
                              </ToggleButton>
                              <ToggleButton fx:id="tbEnCurso" mnemonicParsing="false" styleClass="status-filter" text="En curso" toggleGroup="$tgEstado" userData="EN_CURSO" />
                              <ToggleButton fx:id="tbEntregados" mnemonicParsing="false" styleClass="status-filter" text="Entregados" toggleGroup="$tgEstado" userData="ENTREGADO" />
                           </children>
                        </HBox>

                        <!-- Tarjetas de pedidos (se crean desde el controlador) -->
                        <VBox fx:id="vbPedidos" spacing="12.0" />
                     </children>
                  </VBox>

                  <!-- Resumen de la cuenta -->
                  <VBox fx:id="vbResumen" maxHeight="-Infinity" minWidth="280.0" prefWidth="280.0" spacing="10.0" styleClass="admin-card, order-summary">
                     <children>
                        <Label styleClass="order-summary-title" text="Resumen de tu cuenta" />
                        <HBox>
                           <VBox.margin>
                              <Insets top="6.0" />
                           </VBox.margin>
                           <children>
                              <Label styleClass="summary-label" text="Compras realizadas" />
                              <Region HBox.hgrow="ALWAYS" />
                              <Label fx:id="lblComprasRealizadas" styleClass="summary-value" text="0" />
                           </children>
                        </HBox>
                        <HBox>
                           <children>
                              <Label styleClass="summary-label" text="Camisetas compradas" />
                              <Region HBox.hgrow="ALWAYS" />
                              <Label fx:id="lblCamisetasCompradas" styleClass="summary-value" text="0" />
                           </children>
                        </HBox>
                        <HBox>
                           <children>
                              <Label styleClass="summary-label" text="Total invertido" />
                              <Region HBox.hgrow="ALWAYS" />
                              <Label fx:id="lblTotalInvertido" styleClass="summary-value" text="\$ 0" />
                           </children>
                        </HBox>
                        <Separator styleClass="form-separator" />
                        <Button fx:id="btnSeguirComprando" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onSeguirComprando" prefHeight="40.0" styleClass="admin-button-primary" text="Seguir comprando   →" />
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
   </content>
</ScrollPane>
