<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Sección "Usuarios" del panel del administrador (Controller_view_admin la pone en el centro) -->
<VBox fx:id="vbUsuarios" spacing="14.0" styleClass="admin-content" stylesheets="@../Styles/Style_sheet.css, @../Styles/StyleSheetsComponents/admin_product_component.css" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.Controller_view_admin_users">
   <padding>
      <Insets bottom="20.0" left="24.0" right="24.0" top="18.0" />
   </padding>
   <children>
      <VBox>
         <children>
            <Label fx:id="lblTitulo" styleClass="admin-title" text="Usuarios" />
            <Label fx:id="lblSubtitulo" styleClass="admin-subtitle" text="Cuentas registradas en la tienda: cambia su rol o elimínalas." />
         </children>
      </VBox>

      <!-- Indicadores -->
      <HBox fx:id="hbIndicadores" minHeight="-Infinity" spacing="14.0">
         <children>
            <VBox spacing="2.0" styleClass="kpi-card" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="kpi-label" text="Usuarios registrados" />
                  <Label fx:id="lblTotalUsuarios" styleClass="kpi-value" text="0" />
               </children>
            </VBox>
            <VBox spacing="2.0" styleClass="kpi-card" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="kpi-label" text="Clientes" />
                  <Label fx:id="lblTotalClientes" styleClass="kpi-value, kpi-value-green" text="0" />
               </children>
            </VBox>
            <VBox spacing="2.0" styleClass="kpi-card" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="kpi-label" text="Administradores" />
                  <Label fx:id="lblTotalAdministradores" styleClass="kpi-value" text="0" />
               </children>
            </VBox>
         </children>
      </HBox>

      <!-- Filtros -->
      <HBox fx:id="hbFiltros" minHeight="-Infinity" spacing="12.0">
         <children>
            <TextField fx:id="txtBuscarUsuario" prefHeight="38.0" promptText="Buscar por nombre, correo o identificación..." styleClass="admin-input" HBox.hgrow="ALWAYS" />
            <ComboBox fx:id="cbFiltroRol" prefHeight="38.0" prefWidth="190.0" styleClass="admin-combo" />
         </children>
      </HBox>

      <!-- Mensaje de resultado de una acción -->
      <Label fx:id="lblMensaje" managed="false" maxWidth="1.7976931348623157E308" visible="false" wrapText="true" />

      <!-- Tabla de usuarios -->
      <VBox fx:id="vbTablaUsuarios" styleClass="admin-card" VBox.vgrow="ALWAYS">
         <children>
            <HBox alignment="CENTER_LEFT" minHeight="-Infinity" prefHeight="40.0" styleClass="admin-table-header">
               <padding>
                  <Insets left="16.0" right="26.0" />
               </padding>
               <children>
                  <Label maxWidth="1.7976931348623157E308" minWidth="0.0" prefWidth="260.0" styleClass="admin-table-header-label" text="Usuario" HBox.hgrow="ALWAYS" />
                  <Label minWidth="150.0" prefWidth="150.0" styleClass="admin-table-header-label" text="Identificación" />
                  <Label minWidth="140.0" prefWidth="140.0" styleClass="admin-table-header-label" text="Rol" />
                  <Label minWidth="250.0" prefWidth="250.0" styleClass="admin-table-header-label" text="Acciones" />
               </children>
            </HBox>
            <ScrollPane fx:id="spListaUsuarios" fitToWidth="true" hbarPolicy="NEVER" styleClass="admin-scroll" VBox.vgrow="ALWAYS">
               <content>
                  <VBox fx:id="vbListaUsuarios" />
               </content>
            </ScrollPane>
            <Label fx:id="lblTotalMostrados" minHeight="-Infinity" styleClass="admin-table-footer" text="Mostrando 0 de 0 usuarios" />
         </children>
      </VBox>
   </children>
</VBox>
